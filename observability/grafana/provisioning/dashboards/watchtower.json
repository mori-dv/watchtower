  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Target Availability & Status",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "watchtower_target_up",
          "legendFormat": "{{target}} ({{type}})",
          "refId": "A"
        }
      ],
      "title": "Target Availability Status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "watchtower_consecutive_failures",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "title": "Consecutive Failures",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Performance & Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(watchtower_probe_duration_seconds_bucket[1m])) by (le, target))",
          "legendFormat": "p95 {{target}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(watchtower_probe_duration_seconds_bucket[1m])) by (le, target))",
          "legendFormat": "p50 {{target}}",
          "refId": "B"
        }
      ],
      "title": "Probe Latency (p95 & p50)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "d"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 4,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "watchtower_ssl_cert_expiry_days",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "title": "SSL Certificate Expiry Countdown",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Worker Engine Internals",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 50
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 15 },
      "id": 5,
      "targets": [
        {
          "expr": "watchtower_workers_active",
          "legendFormat": "Active Workers",
          "refId": "A"
        }
      ],
      "title": "Active Workers",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 500
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 15 },
      "id": 6,
      "targets": [
        {
          "expr": "watchtower_job_queue_size",
          "legendFormat": "Job Queue",
          "refId": "A"
        }
      ],
      "title": "Worker Job Queue Depth",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 15 },
      "id": 7,
      "targets": [
        {
          "expr": "sum(rate(watchtower_probes_total[1m])) by (status)",
          "legendFormat": "Probes {{status}}",
          "refId": "A"
        }
      ],
      "title": "Probe Throughput (ops/sec)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["watchtower", "monitoring", "sre"],
  "time": { "from": "now-1h", "to": "now" },
